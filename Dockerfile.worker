FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    cron \
    util-linux \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY app/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app/ .

# cron は docker-compose の環境変数を引き継がないため、
# 起動時に /app/cron_env.sh へ書き出して各ジョブで読み込む。
#   */15  スクレイプ
#   04:20 キャッシュ自動削除（CACHE_RETENTION_DAYS 日より古い画像）
#
# flock -n で多重起動を防ぐ。前回の実行がまだ終わっていなければ即座に諦める。
# これが無いと、1回の実行が詰まった時に15分ごとにプロセスが積み上がり、
# SQLite が "database is locked" で全滅する（実際に35重起動まで積んだ）。
RUN printf '%s\n' \
    '*/15 * * * * cd /app && . /app/cron_env.sh && flock -n /tmp/scraper.lock /usr/local/bin/python scraper.py >> /var/log/scraper.log 2>&1' \
    '20 4 * * * cd /app && . /app/cron_env.sh && flock -n /tmp/cache_cleanup.lock /usr/local/bin/python cache_utils.py >> /var/log/cache_cleanup.log 2>&1' \
    > /etc/cron.d/scraper-cron \
    && chmod 0644 /etc/cron.d/scraper-cron \
    && crontab /etc/cron.d/scraper-cron \
    && touch /var/log/scraper.log /var/log/cache_cleanup.log

CMD ["sh", "-c", "export -p > /app/cron_env.sh && python db.py && flock -n /tmp/scraper.lock python scraper.py; cron -f"]
