# このファイルを .env にコピーして環境に合わせて編集する。
#   cp .env.example .env
# .env は .gitignore 済み。docker compose が自動で読み込む。

# ---- スクレイピングの出口 ----
# 専用回線のプロキシを経由させる場合に設定する。
# 空にすると素通し（Dockerホストの回線からそのまま出る）。
PROXY_URL=

# 期待する出口グローバルIP。設定するとスクレイプ開始前に自動照合し、
# 想定と違えば中止する（proxy設定漏れ・IPv6漏れの検知）。
# 空にすると照合しない。
EXPECTED_EGRESS_IP=

# ---- 画像の保存 ----
# 永続保存する対象カテゴリ（カンマ区切り）。これ以外はキャッシュ扱いで自動削除される。
PERSIST_CATEGORIES=
# キャッシュ自動削除の閾値（日）
CACHE_RETENTION_DAYS=30

# ---- スクレイプ ----
# 1アカウントあたり取得するツイート数
TWEETS_PER_USER=10
# スクレイプログの保持日数
SCRAPE_LOG_RETENTION_DAYS=7

# ---- web ----
# ホスト側の公開ポート
WEB_PORT=8501

# ---- Tumblr共有（任意）----
# 単一投稿のOGPページ /share/<token> を外部公開する際のベースURL。
# 未設定なら共有機能は無効。X-Ray本体ではなく /share と /share-img だけを
# リバースプロキシ（Cloudflare Tunnel / nginx 等）で外に出し、この値をそのドメインにする。
PUBLIC_SHARE_BASE_URL=
# 上記ホスト名宛のリクエストを /share 系だけに制限する（多層防御）。
# 通常は PUBLIC_SHARE_BASE_URL から自動抽出されるので空でよい。
PUBLIC_SHARE_HOST=
# 共有トークンの有効時間（分）。Tumblrが読み終われば不要なので短くてよい。
SHARE_TOKEN_TTL_MIN=60

# ---- Tumblr直接投稿（任意）----
# https://www.tumblr.com/oauth/apps でアプリ登録して取得する。
# 設定するとX-Rayから直接投稿でき、外部公開（トンネル）は不要になる。
TUMBLR_CONSUMER_KEY=
TUMBLR_CONSUMER_SECRET=
# アカウントごとのトークン置き場。tools/tumblr_auth.py が書き込む。
TUMBLR_ACCOUNTS_FILE=/data/tumblr_accounts.json
