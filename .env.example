# このファイルを .env にコピーして環境に合わせて編集する。
#   cp .env.example .env
# .env は .gitignore 済み。docker compose が自動で読み込む。

# ---- スクレイピングの出口 ----
# 専用回線のプロキシを経由させる場合に設定する。
# 空にすると素通し（Dockerホストの回線からそのまま出る）。
PROXY_URL=

# 期待する出口グローバルIP。設定するとスクレイプ開始前に自動照合する。
# 違っていても、proxyが効いていることが確認できれば続行し警告だけ残す
# （回線側のIP変更）。proxyを迂回していた場合だけ中止する。
# 空にすると照合しない。
EXPECTED_EGRESS_IP=

# ---- 画像の保存 ----
# 永続保存する対象カテゴリ（カンマ区切り）。これ以外はキャッシュ扱いで自動削除される。
PERSIST_CATEGORIES=
# キャッシュ自動削除の閾値（日）
CACHE_RETENTION_DAYS=30

# ---- スクレイプ ----
# 最後に取得できてから何時間空いたら画面に警告を出すか。
# 原因に関係なく「取れていない」ことだけを見る見張り。0で無効。
SCRAPE_STALE_HOURS=3
# 1アカウントあたり取得するツイート数
TWEETS_PER_USER=10
# スクレイプログの保持日数
SCRAPE_LOG_RETENTION_DAYS=7
# 巡回が全滅し続けたときに間隔を空ける上限（分）。0で無効。
# 2026-08にX側の変更で全87アカウントが落ち続けたとき、15分おきに叩き続けた。
SCRAPE_BACKOFF_MAX_MIN=240

# ---- IG-Ray 統合（任意） ----
# ig-ray のアーカイブを X-Ray のタイムライン／ギャラリーに混ぜて表示する。
# 取得（instaloader・cron・backfill）は ig-ray 側に残したままで、
# X-Ray からは読むだけ。3つとも空なら統合は無効。
#
# IG_RAY_DATA_DIR : ホスト側の ig-ray の data ディレクトリ（これだけ必須）
# IG_DB_PATH      : 空でよい。/ig-data から ig_ray.db → insta_ray.db の順に探す
# IG_CACHE_DIR    : メディアの置き場（コンテナ内から見たパス）
IG_RAY_DATA_DIR=
IG_DB_PATH=
IG_CACHE_DIR=/ig-data/cache

# ---- IG取得（ig/ 配下。IG-Ray から持ち込み） ----
# 取得そのものの設定。既定では何も常駐しない（IGは叩きすぎると即ブロック）。
#   docker compose --profile ig-cron up -d   で巡回を有効化
IG_RAY_LOGIN_USER=
IG_RAY_INTERVAL=21600          # 巡回間隔（秒）。最低でも数時間空ける
IG_RAY_CRON_LIMIT=6            # 1アカウントあたりの取得件数
IG_RAY_POSTS_ONLY=1            # プロフィールAPIを叩かない（429対策）
IG_RAY_STALE_INTERVALS=3       # 巡回間隔の何倍で「止まっている」とみなすか
IG_RAY_CACHE_RETENTION_DAYS=30
# 出口は X側と共用。上の PROXY_URL / EXPECTED_EGRESS_IP がそのまま使われる。
# **別名で持たないこと。** 同じプロキシを2つの名前で指すと、回線のIPが
# 変わったときに片方だけ直して分離が崩れる。
# IGだけ別回線から出したいときだけ次を書く:
#IG_RAY_EXPECT_EGRESS_IP=
# 母艦のユーザーに合わせる（id -u / id -g が 1000 以外なら設定）
IG_RAY_UID=1000
IG_RAY_GID=1000

# ---- web ----
# 画面に出すバージョン表記の上書き（空ならコード側の既定値を使う）
APP_VERSION=

# ホスト側の公開ポート
WEB_PORT=8501

# リバースプロキシ（Cloudflare Tunnel / nginx 等）で外に出し、この値をそのドメインにする。

# ---- Tumblr直接投稿（任意）----
# https://www.tumblr.com/oauth/apps でアプリ登録して取得する。
# 設定するとX-Rayから直接投稿でき、外部公開（トンネル）は不要になる。
TUMBLR_CONSUMER_KEY=
TUMBLR_CONSUMER_SECRET=
# アカウントごとのトークン置き場。tools/tumblr_auth.py が書き込む。
TUMBLR_ACCOUNTS_FILE=/data/tumblr_accounts.json
# カテゴリ名 → Tumblrタグ の変換表（JSON）。未設定なら {"ギャル":"girl"}。
# 空文字を指定するとそのカテゴリはタグにしない。
# 例: TUMBLR_TAG_MAP={"ギャル":"girl","R18":"nsfw","news":""}
TUMBLR_TAG_MAP=

# これ以上の枚数を選ぶと自動的に下書きにする（既定 3）。
# 枚数が多い投稿を一旦人の目に通すための安全弁。0 にすると自動化しない。
TUMBLR_DRAFT_THRESHOLD=3
